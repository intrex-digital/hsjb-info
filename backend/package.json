{
  "name": "hsjb-info-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute hsjb-info-db --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute hsjb-info-db --file=./src/db/seed.sql",
    "db:seed:blog": "wrangler d1 execute hsjb-info-db --file=./src/db/blog-seed.sql",
    "db:setup": "npm run db:init && npm run db:seed && npm run db:seed:blog",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "itty-router": "^4.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "~5.6.2",
    "wrangler": "^3.90.0"
  }
}
