{
  "name": "hsjb-info",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio website for Md. Jobaer Hossain",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "db:init": "cd backend && npm run db:init",
    "db:seed": "cd backend && npm run db:seed",
    "db:seed:blog": "cd backend && npm run db:seed:blog",
    "db:setup": "cd backend && npm run db:setup",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "typecheck:backend": "cd backend && npm run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
